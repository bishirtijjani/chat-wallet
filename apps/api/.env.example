# Copy to .env and fill in. Never commit .env.

# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (source of truth + ledger)
DATABASE_URL=postgres://caw:caw@localhost:5432/caw

# Auth — JWT signing secrets (use long random strings in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=2592000     # seconds (30 days)

# OTP — HMAC pepper for hashing one-time codes at rest
OTP_PEPPER=dev-otp-pepper-change-me

# SMS provider. "console" prints the OTP to logs (dev only).
SMS_PROVIDER=console

# PSP (Payment Service Provider) — sandbox for M1. "sandbox" simulates funding
# and transfers without touching a real bank. Swap for paystack/monnify later.
PSP_PROVIDER=sandbox

# Scheduler worker (npm run worker) — how often it ticks the ROSCA clock, in ms.
SCHEDULER_INTERVAL_MS=60000
